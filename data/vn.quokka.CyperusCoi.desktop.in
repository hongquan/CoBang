[Desktop Entry]
Name=CyperusCoi
GenericName=QR code scanner
X-GNOME-FullName=CyperusCoi QR code scanner
Comment=Scan and decode QR from camera or static image
Keywords=qr;code;qr-code;qr-decoder;qr-scanner;
