<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.24"/>
  <object class="GtkBox" id="box_url">
    <property name="visible">True</property>
    <child>
      <object class="GtkLinkButton" id="btn_link">
        <property name="visible">True</property>
      </object>
    </child>
  </object>
</interface>
